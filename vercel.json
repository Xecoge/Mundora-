{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/index.html",
      "destination": "/api/app"
    },
    {
      "source": "/tempo-ping",
      "destination": "/api/ping"
    },
    {
      "source": "/ai-proxy/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/music/:src/:path*",
      "destination": "/api/music?src=:src&path=:path*"
    },
    {
      "source": "/crypto-api/:what",
      "destination": "/api/crypto?what=:what"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}